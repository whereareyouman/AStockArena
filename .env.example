# ============ TinySoft 配置 ============
TSL_USERNAME=your_tsl_username
TSL_PASSWORD=your_tsl_password
TSL_SERVER=tsl.tinysoft.com.cn
TSL_PORT=443

# ============ 日期范围配置 ============
# 日期范围以 settings/default_config.json 为准；不要依赖环境变量覆盖。

# ============ LLM API Keys ============
# OpenRouter key: used by all ten benchmark models (including DeepSeek).
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional legacy fallback for non-OpenRouter integrations.
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://openrouter.ai/api/v1

# ============ 前端是否使用Tinysoft ============
USE_LOCAL_DATA_ONLY=false

# ============ 多模型运行模式 ============
PARALLEL_RUN=true

# ============ 回测模式（默认开启） ============
# true: 工具只读 news.csv / shared snapshot，决策时不访问实时外部数据源（可复现）
# false: 允许 search_stock_news 等工具在缓存缺失时实时拉数
BACKTEST_MODE=true

# ============ 实盘常驻调度 ============
# 调度器入口：
#   python -m utilities.live_scheduler settings/default_config.json
# 上服务器前检查：
#   python -m utilities.live_scheduler settings/default_config.json --doctor
# 实盘调度器会按配置的 10:30/11:30/14:00 自动触发，并在子进程里使用 BACKTEST_MODE=false。
# 错误 CSV/JSONL 默认写入 jobs/live_scheduler/errors/YYYY-MM-DD/HH-MM-SS/

# ============ SharedPrefetchCoordinator（多模型共享预抓取） ============
# 锁等待超时（秒）。默认 15。设为 0 表示“无限等待”，可避免抢锁导致 fallback。
SHARED_PREFETCH_LOCK_TIMEOUT=0

# ============ 实时模式配置 ============
# wait: 提前启动，自动等待到 10:30/11:30/14:00 再分别执行
# stop: 只跑到"当前已到的时点"，遇到未来时点就退出（方便 cron 3 次触发）
REALTIME_MODE=wait
