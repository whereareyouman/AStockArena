{
  "agent_type": "AgenticWorkflow",
  "date_range": {
    "init_date": "2026-06-08",
    "end_date": "2026-06-16"
  },
  "run_config": {
    "realtime_mode": "wait",
    "backtest_mode": true,
    "parallel_run": true,
    "parallel_spawn_delay_seconds": 2.0,
    "persist_stock_data_during_snapshot": false,
    "prefetch_news_before_run": true,
    "prefetch_news_lookback_days": 1,
    "prefetch_news_sleep_seconds": 1.0,
    "prefetch_news_timeout": 30,
    "prefetch_news_max_retries": 3,
    "prefetch_news_retry_backoff_seconds": 3.0,
    "prefetch_news_respect_init_date": false,
    "snapshot_hourly_cache_days": 30,
    "live_decision_times": ["10:30:00", "11:30:00", "14:00:00"],
    "live_scheduler_poll_seconds": 60,
    "live_scheduler_catchup_minutes": 20,
    "live_scheduler_model_timeout_seconds": 7200,
    "live_retry_attempts": 3,
    "live_retry_backoff_seconds": [5, 30, 120],
    "live_error_dir": "jobs/live_scheduler/errors",
    "live_snapshot_before_models": true,
    "live_prefetch_news_before_decision": true,
    "live_abort_on_news_prefetch_failure": false,
    "live_abort_on_snapshot_failure": true,
    "live_scheduler_stale_lock_seconds": 86400,
    "live_backtest_mode": false
